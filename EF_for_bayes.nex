END;
begin mrbayes;
log start filename = log.txt;
outgroup MA80011;
outgroup MA81947;
outgroup MA90405;
outgroup MA90409;
outgroup MA90422;
outgroup Sc30802;
charset subset1 = 1-672\3;
charset subset2 = 2-672\3;
charset subset3 = 3-672\3;
partition Names = 3:subset1, subset2, subset3;
set partition=Names;
lset applyto=(1) nst=2 rates=invgamma ngammacat=4;
lset applyto=(2) nst=6 rates=invgamma ngammacat=4;
lset applyto=(3) nst=6 rates=invgamma ngammacat=4;

unlink statefreq=(all) revmat=(all) shape=(all) pinvar=(all) tratio=(all);
prset applyto=(all) ratepr=variable;

mcmcp ngen=60000000
nruns=4
nchains=8
temp=0.15
samplefreq=1000
printfreq=1000
diagnfreq=5000
checkfreq=5000
stoprule=yes
stopval=0.01
savebrlens=yes
checkpoint=yes;

mcmc append=no;

sumt conformat=Simple contype=Allcompat relburnin=yes burninfrac=0.25;
sump relburnin=yes burninfrac=0.25;

end;
